{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orix.comparison.v1.schema.json",
  "title": "ORIX Artifact and Scan Comparison v1",
  "type": "object",
  "required": ["schema_version", "comparison", "artifacts", "indicators", "limitations"],
  "properties": {
    "schema_version": { "const": "orix.comparison.v1" },
    "comparison": { "type": "object", "required": ["baseline_schema", "current_schema", "baseline_root", "current_root", "baseline_artifacts", "current_artifacts", "added", "removed", "modified", "unchanged", "indicators_introduced", "indicators_resolved"], "properties": {
      "baseline_schema": { "enum": ["orix.scan.v1", "orix.artifact.v1"] }, "current_schema": { "enum": ["orix.scan.v1", "orix.artifact.v1"] },
      "baseline_root": { "type": "string" }, "current_root": { "type": "string" },
      "baseline_artifacts": { "type": "integer", "minimum": 0 }, "current_artifacts": { "type": "integer", "minimum": 0 },
      "added": { "type": "integer", "minimum": 0 }, "removed": { "type": "integer", "minimum": 0 }, "modified": { "type": "integer", "minimum": 0 }, "unchanged": { "type": "integer", "minimum": 0 },
      "indicators_introduced": { "type": "integer", "minimum": 0 }, "indicators_resolved": { "type": "integer", "minimum": 0 }
    }, "additionalProperties": false },
    "artifacts": { "type": "object", "required": ["added", "removed", "modified", "unchanged"], "properties": {
      "added": { "type": "array", "items": { "$ref": "#/$defs/identity" } }, "removed": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
      "modified": { "type": "array", "items": { "type": "object", "required": ["path", "before_sha256", "after_sha256"], "properties": { "path": { "type": "string" }, "before_sha256": { "$ref": "#/$defs/hash" }, "after_sha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": true } },
      "unchanged": { "type": "array", "items": { "$ref": "#/$defs/identity" } }
    }, "additionalProperties": false },
    "indicators": { "type": "object", "required": ["introduced", "resolved"], "properties": { "introduced": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "resolved": { "type": "array", "items": { "$ref": "#/$defs/finding" } } }, "additionalProperties": false },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "identity": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" }, "format": { "type": "string" } }, "additionalProperties": true },
    "finding": { "type": "object", "required": ["path", "rule_id", "severity", "summary"], "properties": { "path": { "type": "string" }, "rule_id": { "type": "string" }, "title": { "type": "string" }, "severity": { "type": "string" }, "summary": { "type": "string" } }, "additionalProperties": true }
  },
  "additionalProperties": false
}
