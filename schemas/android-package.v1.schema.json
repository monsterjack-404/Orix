{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orix.dev/schemas/android-package.v1.schema.json",
  "title": "ORIX Android APK/AAB Inventory Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "format",
    "detected",
    "archive",
    "archive_entries",
    "summary",
    "manifests",
    "dex",
    "native_libraries",
    "signatures",
    "limitations",
    "warnings",
    "signing_block",
    "bundle"
  ],
  "properties": {
    "schema_version": {
      "const": "orix.android-package.v1"
    },
    "format": {
      "enum": [
        "APK",
        "AAB",
        "Android package candidate"
      ]
    },
    "detected": {
      "type": "boolean"
    },
    "archive": {
      "type": "object",
      "required": [
        "entry_count",
        "safe_entry_count",
        "unsafe_or_symlink_entries",
        "entries_reported",
        "entries_omitted",
        "zip64",
        "duplicate_path_names",
        "duplicate_path_entries"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "safe_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_or_symlink_entries": {
          "type": "integer",
          "minimum": 0
        },
        "entries_reported": {
          "type": "integer",
          "minimum": 0
        },
        "entries_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "zip64": {
          "type": "boolean"
        },
        "duplicate_path_names": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_path_entries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "dex_entries",
        "dex_metadata_parsed",
        "dex_entries_not_inspected",
        "native_libraries",
        "resources_table_present",
        "manifest_entries",
        "v1_signature_files",
        "dex_entries_reported",
        "dex_entries_omitted",
        "native_libraries_reported",
        "native_libraries_omitted",
        "manifest_entries_reported",
        "manifest_entries_omitted",
        "v1_signature_files_reported",
        "v1_signature_files_omitted",
        "duplicate_dex_paths",
        "duplicate_manifest_paths"
      ],
      "properties": {
        "dex_entries": {
          "type": "integer",
          "minimum": 0
        },
        "dex_metadata_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "dex_entries_not_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "native_libraries": {
          "type": "integer",
          "minimum": 0
        },
        "resources_table_present": {
          "type": "boolean"
        },
        "manifest_entries": {
          "type": "integer",
          "minimum": 0
        },
        "v1_signature_files": {
          "type": "integer",
          "minimum": 0
        },
        "dex_entries_reported": {
          "type": "integer",
          "minimum": 0
        },
        "dex_entries_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "native_libraries_reported": {
          "type": "integer",
          "minimum": 0
        },
        "native_libraries_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_entries_reported": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_entries_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "v1_signature_files_reported": {
          "type": "integer",
          "minimum": 0
        },
        "v1_signature_files_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_dex_paths": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_manifest_paths": {
          "type": "integer",
          "minimum": 0
        },
        "apk_signing_block_present": {
          "type": "boolean"
        },
        "apk_signing_block_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "aab_modules": {
          "type": "integer",
          "minimum": 0
        },
        "aab_modules_reported": {
          "type": "integer",
          "minimum": 0
        },
        "aab_modules_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "bundle_config_present": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "binary_xml",
          "path_truncated",
          "path_original_length"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "decoded",
              "binary-xml-header",
              "unknown-or-invalid-header",
              "manifest-size-limit",
              "malformed-binary-xml",
              "invalid-local-range",
              "encrypted",
              "compressed",
              "invalid-local-header",
              "local-header-mismatch"
            ]
          },
          "binary_xml": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "chunk_type": {
            "type": "string"
          },
          "header_size": {
            "type": "integer",
            "minimum": 0
          },
          "declared_size": {
            "type": "integer",
            "minimum": 0
          },
          "path_truncated": {
            "type": "boolean"
          },
          "path_original_length": {
            "type": "integer",
            "minimum": 0
          },
          "decoded": {
            "type": "boolean"
          },
          "package_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "version_code": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "version_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "maxSdkVersion"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "maxSdkVersion": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "name",
                "exported",
                "permission",
                "process",
                "authorities",
                "targetActivity"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "activity",
                    "activity-alias",
                    "service",
                    "receiver",
                    "provider"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exported": {
                  "type": [
                    "boolean",
                    "integer",
                    "string",
                    "null"
                  ]
                },
                "permission": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "process": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "authorities": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "targetActivity": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "application": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "label": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "icon": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "debuggable": {
                "type": [
                  "boolean",
                  "integer",
                  "string",
                  "null"
                ]
              },
              "allowBackup": {
                "type": [
                  "boolean",
                  "integer",
                  "string",
                  "null"
                ]
              },
              "usesCleartextTraffic": {
                "type": [
                  "boolean",
                  "integer",
                  "string",
                  "null"
                ]
              },
              "networkSecurityConfig": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "counts": {
            "type": "object",
            "required": [
              "chunks",
              "strings",
              "elements",
              "attributes",
              "resource_map_entries"
            ],
            "properties": {
              "chunks": {
                "type": "integer",
                "minimum": 0
              },
              "strings": {
                "type": "integer",
                "minimum": 0
              },
              "elements": {
                "type": "integer",
                "minimum": 0
              },
              "attributes": {
                "type": "integer",
                "minimum": 0
              },
              "resource_map_entries": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "output_truncated": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "uncompressed_size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "dex": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "uncompressed_size",
          "path_truncated",
          "path_original_length"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "metadata-parsed",
              "entry-limit",
              "entry-size-limit",
              "aggregate-size-limit",
              "invalid-local-range",
              "encrypted",
              "compressed",
              "invalid-local-header",
              "local-header-mismatch",
              "size-mismatch",
              "rejected",
              "duplicate-path"
            ]
          },
          "uncompressed_size": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "file_size": {
            "type": "integer",
            "minimum": 0
          },
          "counts": {
            "type": "object"
          },
          "strings": {
            "type": "array"
          },
          "types": {
            "type": "array"
          },
          "classes": {
            "type": "array"
          },
          "map_items": {
            "type": "array"
          },
          "output_truncated": {
            "type": "boolean"
          },
          "integrity": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "path_truncated": {
            "type": "boolean"
          },
          "path_original_length": {
            "type": "integer",
            "minimum": 0
          },
          "proto_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "field_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "method_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "class_data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "class_data_summary": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "native_libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "compressed_size",
          "uncompressed_size",
          "path_truncated",
          "path_original_length"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "compressed_size": {
            "type": "integer",
            "minimum": 0
          },
          "uncompressed_size": {
            "type": "integer",
            "minimum": 0
          },
          "path_truncated": {
            "type": "boolean"
          },
          "path_original_length": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "size_bytes",
        "sha256",
        "stable_during_read"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stable_during_read": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "archive_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "path_truncated",
          "path_original_length",
          "kind",
          "compression_method",
          "encrypted",
          "compressed_size",
          "uncompressed_size",
          "crc32",
          "local_header_valid",
          "local_data_range_valid",
          "unix_mode"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "path_truncated": {
            "type": "boolean"
          },
          "path_original_length": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "compression_method": {
            "type": "string"
          },
          "encrypted": {
            "type": "boolean"
          },
          "compressed_size": {
            "type": "integer",
            "minimum": 0
          },
          "uncompressed_size": {
            "type": "integer",
            "minimum": 0
          },
          "crc32": {
            "type": "string",
            "pattern": "^0x[a-f0-9]{8}$"
          },
          "local_header_valid": {
            "type": "boolean"
          },
          "local_data_range_valid": {
            "type": "boolean"
          },
          "unix_mode": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "signing_block": {
      "type": "object",
      "required": [
        "status",
        "offset",
        "size_bytes",
        "pair_count",
        "schemes",
        "unknown_ids",
        "duplicate_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "absent",
            "malformed",
            "not-applicable"
          ]
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "schemes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "value_size"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^0x[a-f0-9]{8}$"
              },
              "name": {
                "type": "string"
              },
              "value_size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[a-f0-9]{8}$"
          }
        },
        "duplicate_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "count"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^0x[a-f0-9]{8}$"
              },
              "count": {
                "type": "integer",
                "minimum": 2
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "required": [
        "status",
        "bundle_config_present",
        "module_count",
        "modules_reported",
        "modules_omitted",
        "modules",
        "module_semantics_decoded"
      ],
      "properties": {
        "status": {
          "enum": [
            "recognized",
            "not-applicable"
          ]
        },
        "bundle_config_present": {
          "type": "boolean"
        },
        "module_count": {
          "type": "integer",
          "minimum": 0
        },
        "modules_reported": {
          "type": "integer",
          "minimum": 0
        },
        "modules_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "module_semantics_decoded": {
          "const": false
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "name_truncated",
              "name_original_length",
              "manifest_present",
              "dex_entries",
              "native_libraries",
              "resources_pb_present",
              "resource_paths",
              "asset_paths",
              "root_paths"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "name_truncated": {
                "type": "boolean"
              },
              "name_original_length": {
                "type": "integer",
                "minimum": 0
              },
              "manifest_present": {
                "type": "boolean"
              },
              "dex_entries": {
                "type": "integer",
                "minimum": 0
              },
              "native_libraries": {
                "type": "integer",
                "minimum": 0
              },
              "resources_pb_present": {
                "type": "boolean"
              },
              "resource_paths": {
                "type": "integer",
                "minimum": 0
              },
              "asset_paths": {
                "type": "integer",
                "minimum": 0
              },
              "root_paths": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
