{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orix.rizin-functions.v1.schema.json",
  "title": "ORIX Rizin Function Analysis Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "artifact", "functions", "disassembly", "summary", "diagnostics", "notes"],
  "properties": {
    "schema_version": { "const": "orix.rizin-functions.v1" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter_version", "engine_version", "executable"],
      "properties": {
        "id": { "const": "rizin.static" },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "engine_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "stable_during_analysis"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stable_during_analysis": { "const": true }
      }
    },
    "functions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "offset", "size", "real_size", "bits", "type", "call_type", "signature", "basic_blocks", "edges", "arguments", "locals", "no_return"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "offset": { "type": "integer", "minimum": 0 },
          "size": { "type": ["integer", "null"], "minimum": 0 },
          "real_size": { "type": ["integer", "null"], "minimum": 0 },
          "bits": { "type": ["integer", "null"], "minimum": 1 },
          "type": { "type": ["string", "null"], "maxLength": 64 },
          "call_type": { "type": ["string", "null"], "maxLength": 64 },
          "signature": { "type": ["string", "null"], "maxLength": 1024 },
          "basic_blocks": { "type": ["integer", "null"], "minimum": 0 },
          "edges": { "type": ["integer", "null"], "minimum": 0 },
          "arguments": { "type": ["integer", "null"], "minimum": 0 },
          "locals": { "type": ["integer", "null"], "minimum": 0 },
          "no_return": { "type": ["boolean", "null"] }
        }
      }
    },
    "disassembly": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["function_name", "address", "instruction_limit", "instructions", "total_returned", "instruction_limit_reached"],
          "properties": {
            "function_name": { "type": "string", "minLength": 1, "maxLength": 512 },
            "address": { "type": "integer", "minimum": 0 },
            "instruction_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "instructions": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["offset", "size", "bytes", "opcode", "disassembly", "operation_type", "jump", "fail"],
                "properties": {
                  "offset": { "type": "integer", "minimum": 0 },
                  "size": { "type": ["integer", "null"], "minimum": 1 },
                  "bytes": { "type": ["string", "null"], "maxLength": 128 },
                  "opcode": { "type": ["string", "null"], "maxLength": 512 },
                  "disassembly": { "type": ["string", "null"], "maxLength": 512 },
                  "operation_type": { "type": ["string", "null"], "maxLength": 64 },
                  "jump": { "type": ["integer", "null"], "minimum": 0 },
                  "fail": { "type": ["integer", "null"], "minimum": 0 }
                }
              }
            },
            "total_returned": { "type": "integer", "minimum": 0 },
            "instruction_limit_reached": { "type": "boolean" }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functions_total", "functions_returned", "functions_truncated", "disassembly_included"],
      "properties": {
        "functions_total": { "type": "integer", "minimum": 0 },
        "functions_returned": { "type": "integer", "minimum": 0 },
        "functions_truncated": { "type": "boolean" },
        "disassembly_included": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_probe_duration_ms", "function_scan_duration_ms", "disassembly_duration_ms", "captured_output_bytes", "stderr"],
      "properties": {
        "version_probe_duration_ms": { "type": "integer", "minimum": 0 },
        "function_scan_duration_ms": { "type": "integer", "minimum": 0 },
        "disassembly_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "captured_output_bytes": { "type": "integer", "minimum": 0 },
        "stderr": { "type": "string", "maxLength": 1024 }
      }
    },
    "notes": { "type": "array", "items": { "type": "string", "maxLength": 1024 } }
  }
}