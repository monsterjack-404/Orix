{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orix.dev/schemas/orix.architecture.v1.schema.json",
  "title": "ORIX Project Architecture Report",
  "description": "Static diagnostics derived from the resolved local-import graph in an ORIX project-intelligence report. Heuristic findings are not proof of runtime behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "summary",
    "coverage",
    "entrypoint_candidates",
    "cycles",
    "hotspots",
    "isolated_files",
    "leaf_modules",
    "unreachable_from_candidates",
    "language_counts",
    "directory_counts",
    "external_imports",
    "graph",
    "limitations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "orix.architecture.v1"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "root",
        "scanned_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "scanned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "source_files",
        "source_import_edges",
        "entrypoint_candidates",
        "cycle_count",
        "cycle_participants",
        "isolated_files",
        "leaf_modules",
        "reachable_from_candidates",
        "unreachable_from_candidates",
        "external_import_specifiers",
        "declared_dependencies",
        "locked_packages",
        "lockfile_dependency_edges"
      ],
      "properties": {
        "source_files": {
          "type": "integer",
          "minimum": 0
        },
        "source_import_edges": {
          "type": "integer",
          "minimum": 0
        },
        "entrypoint_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_count": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_participants": {
          "type": "integer",
          "minimum": 0
        },
        "isolated_files": {
          "type": "integer",
          "minimum": 0
        },
        "leaf_modules": {
          "type": "integer",
          "minimum": 0
        },
        "reachable_from_candidates": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unreachable_from_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "external_import_specifiers": {
          "type": "integer",
          "minimum": 0
        },
        "declared_dependencies": {
          "type": "integer",
          "minimum": 0
        },
        "locked_packages": {
          "type": "integer",
          "minimum": 0
        },
        "lockfile_dependency_edges": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "input_inventory_complete",
        "graph_analysis_complete",
        "analyzed_nodes",
        "omitted_nodes",
        "analyzed_edges",
        "omitted_edges",
        "invalid_nodes",
        "invalid_edges",
        "duplicate_edges",
        "reachability_available",
        "skipped_project_entries"
      ],
      "properties": {
        "input_inventory_complete": {
          "type": "boolean"
        },
        "graph_analysis_complete": {
          "type": "boolean"
        },
        "analyzed_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed_edges": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_edges": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_edges": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_edges": {
          "type": "integer",
          "minimum": 0
        },
        "reachability_available": {
          "type": "boolean"
        },
        "skipped_project_entries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "entrypoint_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "confidence",
          "reasons"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "heuristic",
              "strong-heuristic"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "members",
          "member_count",
          "internal_edge_count",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_count": {
            "type": "integer",
            "minimum": 1
          },
          "internal_edge_count": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "self-loop",
              "strongly-connected-component"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "in_degree",
          "out_degree",
          "connectivity_score"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "in_degree": {
            "type": "integer",
            "minimum": 0
          },
          "out_degree": {
            "type": "integer",
            "minimum": 0
          },
          "connectivity_score": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "isolated_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "leaf_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unreachable_from_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "directory_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "external_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "specifier",
          "import_count",
          "used_by"
        ],
        "properties": {
          "specifier": {
            "type": "string"
          },
          "import_count": {
            "type": "integer",
            "minimum": 1
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "language",
              "in_degree",
              "out_degree",
              "connectivity_score",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "in_degree": {
                "type": "integer",
                "minimum": 0
              },
              "out_degree": {
                "type": "integer",
                "minimum": 0
              },
              "connectivity_score": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "module",
                  "isolated",
                  "entrypoint-candidate",
                  "leaf"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "kind",
              "label"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
