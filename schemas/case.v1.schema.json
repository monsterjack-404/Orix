{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://orix.dev/schemas/case.v1.schema.json",
  "title":"ORIX Investigation Case","type":"object",
  "required":["schema_version","case","artifacts","analyses","findings","notes","relationships","timeline","integrity"],
  "properties":{
    "schema_version":{"const":"orix.case.v1"},
    "case":{"type":"object","required":["id","title","description","created_at","updated_at","status"],"properties":{"id":{"type":"string","format":"uuid"},"title":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","maxLength":4000},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"status":{"enum":["open","in_review","closed"]}},"additionalProperties":false},
    "artifacts":{"type":"array","items":{"type":"object","required":["artifact_id","sha256","size_bytes","source_path","stable_during_analysis"]}},
    "analyses":{"type":"array","items":{"type":"object","required":["run_id","tool","report_schema","report_path","report_sha256","options_sha256","recorded_at","coverage","limitations"]}},
    "findings":{"type":"array","items":{"type":"object","required":["finding_id","fingerprint","rule_id","title","severity","confidence","status","evidence","status_history"]}},
    "notes":{"type":"array","items":{"type":"object","required":["note_id","text","links","created_at"]}},
    "relationships":{"type":"array","items":{"type":"object","required":["relationship_id","from_type","from_id","to_type","to_id","relation","confidence","created_at"]}},
    "timeline":{"type":"array","items":{"type":"object","required":["sequence","event","timestamp","record_hash"]}},
    "integrity":{"type":"object","required":["valid","records","head_hash"],"properties":{"valid":{"const":true},"records":{"type":"integer","minimum":1},"head_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
  },"additionalProperties":false
}