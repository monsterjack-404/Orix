{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orix.indicator.v1.schema.json",
  "title": "ORIX Static Indicator v1",
  "description": "An explainable static triage finding. Severity is priority, not malware probability.",
  "type": "object",
  "required": ["rule_id", "title", "severity", "confidence", "summary", "evidence"],
  "properties": {
    "rule_id": { "type": "string", "pattern": "^ORIX-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
    "confidence": { "type": "string", "enum": ["observed", "derived", "heuristic"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "offset": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 0 },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "details": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
