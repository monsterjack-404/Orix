{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orix.dev/schemas/project.v1.schema.json",
  "title": "ORIX Project Intelligence Report",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "git",
    "summary",
    "detection",
    "manifests",
    "dependencies",
    "lockfiles",
    "resolved_dependencies",
    "dependency_graph",
    "files",
    "symbols",
    "graph",
    "findings",
    "coverage",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "orix.project.v1"
    },
    "project": {
      "type": "object",
      "required": [
        "root",
        "name",
        "scanned_at"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "files_analyzed",
        "entries_seen",
        "bytes_analyzed",
        "languages",
        "declared_dependencies",
        "source_symbols",
        "source_import_edges",
        "secret_pattern_matches",
        "locked_packages",
        "dependency_edges",
        "lockfile_edges",
        "git_present"
      ],
      "properties": {
        "electron_findings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "detection": {
      "type": "object",
      "required": [
        "package_managers",
        "has_readme",
        "has_license",
        "has_ci",
        "has_tests",
        "has_container"
      ]
    },
    "manifests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "language",
          "extension",
          "text_analyzed"
        ],
        "properties": {
          "javascript_analysis": {
            "type": "object",
            "required": [
              "tokens",
              "token_limit_reached",
              "imports_truncated",
              "symbols_truncated",
              "limitations"
            ],
            "properties": {
              "tokens": {
                "type": "integer",
                "minimum": 0
              },
              "token_limit_reached": {
                "type": "boolean"
              },
              "imports_truncated": {
                "type": "boolean"
              },
              "symbols_truncated": {
                "type": "boolean"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "confidence",
          "file",
          "line",
          "label",
          "evidence"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "complete",
        "truncated",
        "limits",
        "skipped",
        "skipped_entries"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "lockfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "ecosystem",
          "format",
          "packages",
          "edges",
          "warnings",
          "complete"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "ecosystem": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "lockfile_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "root_dependencies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "root_edges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    },
    "resolved_dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependency_graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "present",
        "supported",
        "kind",
        "branch",
        "head_oid",
        "branches",
        "tags",
        "remotes",
        "shallow",
        "object_format",
        "storage",
        "head_commit",
        "warnings"
      ]
    },
    "electron": {
      "type": "object",
      "required": [
        "detected",
        "confidence",
        "evidence",
        "electron_source_files",
        "process_roles",
        "findings",
        "analysis_truncated_files",
        "limitations"
      ],
      "properties": {
        "detected": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "strong-project-metadata",
            "heuristic-source-signal",
            "not-detected"
          ]
        },
        "evidence": {
          "type": "array"
        },
        "electron_source_files": {
          "type": "array"
        },
        "process_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array"
        },
        "analysis_truncated_files": {
          "type": "integer",
          "minimum": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
