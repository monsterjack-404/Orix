    <OutputType>Exe</OutputType>
    <AssemblyName>orix-windows-appcontainer-child-probe</AssemblyName>
    <RootNamespace>OrixWindowsSandbox.Tests</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
